generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScreeningResult {
  id             String   @id @default(uuid()) @db.Uuid
  nickname       String   @db.VarChar(40)
  testType       String   @db.VarChar(16)
  answers        Json
  categoryScores Json
  totalScore     Int
  maxScore       Int
  riskLevel      String   @db.VarChar(32)
  riskTitle      String   @db.VarChar(160)
  consentGiven   Boolean
  submittedAt    DateTime @default(now())

  @@index([submittedAt])
  @@index([testType])
  @@index([riskLevel])
}
